# Main HTTPS server: serves both .pl and .org.
server {
    listen 443 ssl;
    server_name baplatform.pl www.baplatform.pl baplatform.org www.baplatform.org;

    # Reject unexpected hosts even if this is the fallback HTTPS server.
    if ($host !~* ^(baplatform\.pl|www\.baplatform\.pl|baplatform\.org|www\.baplatform\.org)$) {
        return 444;
    }

    ssl_certificate /etc/letsencrypt/live/baplatform.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baplatform.pl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10M;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location /static/ {
        root /var/www/business_apps/;
    }

    location /media/ {
        root /var/www/business_apps/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn.sock:;

        proxy_connect_timeout 120s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}

# HTTP to HTTPS redirect: preserves your existing list of hosts.
server {
    listen 80;
    server_name baplatform.pl www.baplatform.pl baplatform.org www.baplatform.org baplatform.app www.baplatform.app 35.184.88.161;

    if ($host !~* ^(baplatform\.pl|www\.baplatform\.pl|baplatform\.org|www\.baplatform\.org|baplatform\.app|www\.baplatform\.app|35\.184\.88\.161)$) {
        return 444;
    }

    return 301 https://$host$request_uri;
}
